DATABASE_URL=postgres://salao:salao@localhost:5432/salao

# IA: google (Gemini, padrão) ou anthropic (Claude)
LLM_PROVIDER=google
GOOGLE_API_KEY=                               # aistudio.google.com (plano gratuito usa os dados p/ melhorar produtos da Google)
ANTHROPIC_API_KEY=                            # só com LLM_PROVIDER=anthropic
MODEL=gemini-3.6-flash                        # vazio = gemini-3.5-flash (google) ou claude-sonnet-4-6 (anthropic)
# Se o modelo falhar (cota 429 / sobrecarga 503), tenta estes em ordem. Útil no plano gratuito (cota separada por modelo).
MODEL_FALLBACKS=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Com o simulador (npm run dev:sim) use: WA_API_BASE_URL=http://localhost:4000 e valores
# inventados em WA_TOKEN, WA_PHONE_NUMBER_ID, WA_VERIFY_TOKEN, WA_APP_SECRET e ADMIN_TOKEN.
WA_API_BASE_URL=https://graph.facebook.com   # dev: http://localhost:4000
WA_API_VERSION=v25.0                          # versão dos exemplos atuais da doc da Meta (set/2026)
WA_TOKEN=                                     # Meta: API Setup > Generate access token (temporário) ou token de System User (README)
WA_PHONE_NUMBER_ID=                           # Meta: API Setup, logo abaixo do número de teste em "From"
WA_VERIFY_TOKEN=                              # você inventa; repita igual em WhatsApp > Configuration > Verify token
WA_APP_SECRET=                                # Meta: App settings > Basic > App secret (Show)

DONO_WHATSAPP=5543999999999                   # celular da dona (DDI+DDD+número); com a Meta, cadastre-o em API Setup > To
PAUSA_HUMANO_HORAS=12
NOVA_CONVERSA_HORAS=6
BUFFER_MS=6000
# Ritmo do bot (ms). Aumente para parecer mais devagar.
RITMO_DIGITACAO_MS_POR_CARACTERE=60
RITMO_DIGITACAO_MIN_MS=2000
RITMO_DIGITACAO_MAX_MS=10000
RITMO_ENTRE_BOLHAS_MIN_MS=1000
RITMO_ENTRE_BOLHAS_MAX_MS=2500
RITMO_LEITURA_MIN_MS=1500
RITMO_LEITURA_MAX_MS=4000
RITMO_LEITURA_MS_POR_CARACTERE=25
RITMO_LEITURA_TETO_MS=8000
ADMIN_TOKEN=
PORT=3000

# simulador
SIM_PORT=4000
BOT_URL=http://localhost:3000